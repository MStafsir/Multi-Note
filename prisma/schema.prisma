// ============================================================
// MODUL 2: Database Schema & Foundation
// MODUL 49.10: PostgreSQL-compatible schema
// Sandbox: uses SQLite (no external Postgres available)
// Deployment: change provider to "postgresql" and set DATABASE_URL
//   to Supabase/Neon Postgres connection string.
// IMPORTANT: Prisma connects with table-owner role by default,
//   which BYPASSRLS — Row Level Security policies are NOT enforced
//   unless you explicitly set the connection role to a non-superuser.
//   See 49.11 verification below.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- NextAuth.js Required Tables (Modul 3) ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  nodes         Node[]
  profile       Profile?
  calculations  CalculationHistory[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  comments      Comment[]
  noteTemplates NoteTemplate[]
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]
  apiKeys              ApiKey[]
  webhookSubscriptions WebhookSubscription[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- User Profile with Storage Quota (Modul 6 prep) ---
// MODUL 36: Added role column (enum: user/admin)
model Profile {
  id             String @id @default(cuid())
  userId         String @unique
  role           String @default("user") // "user" | "admin" — Modul 36.1
  storageUsedBytes BigInt @default(0)
  quotaLimitBytes  BigInt @default(5368709120) // 5GB default
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Core Node Table (Modul 2.2) ---
// MODUL 40.1: Added workspaceId (nullable) — backward-compatible, null = personal workspace
model Node {
  id           String    @id @default(cuid())
  ownerId      String
  parentId     String?
  workspaceId  String?   // MODUL 40.1 — nullable FK, null = personal (individual) workspace
  type         String    // "file" | "folder" | "note" — discriminated union
  name         String
  isFavorite   Boolean   @default(false) // Modul 21.3 — direct column for high-frequency access
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // soft-delete (Modul 4.3)

  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent     Node?          @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Node[]         @relation("NodeTree")
  workspace  Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metadata   FileMetadata?
  note       NoteContent?
  shares        NodeShare[]
  tags          NodeTag[]
  activity      ActivityLog[]
  versions      FileVersion[]
  revisions     NoteRevision[]
  noteDatabases NoteDatabase[]
  sourceLinks   NoteLink[]  @relation("SourceLinks")
  targetLinks   NoteLink[]  @relation("TargetLinks")
  comments      Comment[]

  @@index([ownerId, parentId])
  @@index([ownerId, type])
  @@index([deletedAt])
  @@index([ownerId, isFavorite]) // Modul 21.4 — favorites filter
  @@index([workspaceId]) // MODUL 40.3 — workspace-scoped queries
}

// --- File Metadata (Modul 2.6) ---
model FileMetadata {
  nodeId        String @id @default(cuid())
  storagePath   String
  mimeType      String
  sizeBytes     BigInt
  checksumSha256 String?

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

// --- Note Content (Modul 2.7) ---
model NoteContent {
  nodeId      String @id @default(cuid())
  contentJson String // Tiptap ProseMirror JSON — NOT raw HTML/Markdown

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

// --- Node Shares (Modul 13) ---
model NodeShare {
  id               String    @id @default(cuid())
  nodeId           String
  sharedWithUserId String?   // null for public share links
  permissionLevel  String    // "view" | "comment" | "edit"
  shareLinkToken   String?   @unique // UUID token for public share links
  shareLinkExpiry  DateTime? // optional expiry for share links
  linkType         String?   // "public" | "private" — null for user shares
  createdAt        DateTime  @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, sharedWithUserId])
  @@index([shareLinkToken])
}

// --- Tags (Modul 21 prep) ---
model Tag {
  id       String @id @default(cuid())
  ownerId  String
  name     String
  colorHex String @default("#6B7280")

  nodes NodeTag[]

  @@unique([ownerId, name])
}

model NodeTag {
  nodeId String
  tagId  String

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([nodeId, tagId])
}

// --- Activity Log (Modul 19: Activity Log & Audit Trail) ---
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String
  nodeId     String?
  actionType String   // "create" | "rename" | "move" | "delete" | "restore" | "share" | "edit"
  metadata   String?  // JSON string
  createdAt  DateTime @default(now())

  node Node? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([nodeId, createdAt])
  @@index([actorId, createdAt])
}

// --- File Versions (Modul 15: Version History & Snapshot) ---
model FileVersion {
  id             String   @id @default(cuid())
  nodeId         String
  storagePath    String   // versioned file path in storage
  versionNumber  Int      // auto-increment per node_id
  sizeBytes      BigInt
  checksumSha256 String?
  createdById    String?  // user who uploaded this version
  createdAt      DateTime @default(now())

  node Node? @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, versionNumber])
}

// --- Note Revisions (Modul 16: Version History & Revision Diffing) ---
model NoteRevision {
  id                  String   @id @default(cuid())
  nodeId              String
  contentJsonSnapshot String   // Tiptap ProseMirror JSON snapshot
  revisionNumber      Int      // auto-increment per node_id
  triggerType         String   // "autosave" | "manual" | "restore"
  createdAt           DateTime @default(now())

  node Node? @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, revisionNumber])
  @@index([nodeId, createdAt])
}

// --- Calculation History (Modul 11: Calculator Widget) ---
model CalculationHistory {
  id         String   @id @default(cuid())
  userId     String
  expression String
  result     String
  mode       String   // "basic" | "scientific" | "unit"
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// --- Notifications (Modul 20: Notification System) ---
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  type        String    // "share_received" | "comment_added" | "mention" | "quota_warning" | "monitoring_alert"
  payload     String?   // JSON string with notification details
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

// --- Notification Preferences (Modul 20.5) ---
model NotificationPreference {
  id               String @id @default(cuid())
  userId           String @unique
  shareReceived    String @default("in_app") // "in_app" | "email" | "both" | "off"
  commentAdded     String @default("in_app")
  mention          String @default("in_app")
  quotaWarning     String @default("both") // default: both in-app + email for critical

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// MODUL 31: Database Block — Schema & Property Type Engine
// ============================================================

// Database block exists as rich-block inside content_json (Tiptap DatabaseBlock node)
// NOT a new NodeType — prevents discriminated union inflation (Modul 1.3 lock)
model NoteDatabase {
  id             String   @id @default(cuid())
  parentNoteId   String   // FK to nodes.id — note that contains this database block
  title          String   @default("Untitled Database")
  schema         String   // JSON string: array of {column_id, name, type, config}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parentNote Node           @relation(fields: [parentNoteId], references: [id], onDelete: Cascade)
  rows       DatabaseRow[]
  views      DatabaseView[]

  @@index([parentNoteId])
}

model DatabaseRow {
  id         String @id @default(cuid())
  databaseId String
  cellData   String // JSON string: key=column_id, value=cell content
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  database NoteDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
}

// ============================================================
// MODUL 32: Database View — Rendering, Filter, Sort & Layout
// ============================================================

model DatabaseView {
  id         String   @id @default(cuid())
  databaseId String
  type       String   // "table" | "board" | "list" | "gallery"
  name       String   @default("Default View")
  config     String   // JSON string: {filters, sorts, groupBy, fieldOrder, etc.}
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  database NoteDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
}

// ============================================================
// MODUL 33: Note Template & Duplication System
// ============================================================

model NoteTemplate {
  id                  String   @id @default(cuid())
  ownerId             String?  // null = system built-in template
  title               String
  contentJsonTemplate String   // Tiptap ProseMirror JSON template with placeholder blocks
  category            String   // "meeting_notes" | "project_plan" | "journal" | "weekly_review" | "blank" | "custom"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([category])
}

// ============================================================
// MODUL 34: Backlink & Bi-directional Note-Linking Graph
// ============================================================

// note_links: populated/updated via parser when content_json is saved
// Extracts all NoteLinkMention nodes from Tiptap document tree
model NoteLink {
  id          String   @id @default(cuid())
  sourceNodeId String  // note that contains the [[nama-note]] link
  targetNodeId String  // note being referenced
  createdAt   DateTime @default(now())

  sourceNode Node @relation("SourceLinks", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode Node @relation("TargetLinks", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

// ============================================================
// MODUL 35: In-Note Threaded Commenting System
// ============================================================

model Comment {
  id               String    @id @default(cuid())
  nodeId           String    // FK to nodes.id — note where comment is anchored
  parentCommentId  String?   // nullable — self-referencing for threaded replies (max 1 level)
  authorId         String
  content          String    // plain text — NOT rich-block
  anchorPosition   String?   // JSON string: ProseMirror mapping/transform for text-anchor
  resolvedAt       DateTime? // nullable — toggle resolved/unresolved
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  node          Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  parentComment Comment? @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentThread")
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@index([nodeId, resolvedAt])
  @@index([parentCommentId])
}

// ============================================================
// MODUL 36: Analytics Snapshot — Materialized view equivalent
// Pre-computed metrics to avoid heavy real-time queries on every load
// Refreshed on scheduled basis (not real-time)
// ============================================================

model AnalyticsSnapshot {
  id                String   @id @default(cuid())
  snapshotDate      String   // YYYY-MM-DD format for daily snapshots
  dauCount          Int      @default(0)    // Daily Active Users
  mauCount          Int      @default(0)    // Monthly Active Users (snapshot day)
  totalStorageBytes BigInt   @default(0)    // Platform-wide storage aggregation
  totalUsers        Int      @default(0)
  totalNodes        Int      @default(0)
  uploadsPerDay     Int      @default(0)    // File uploads on snapshot day
  notesCreatedPerDay Int     @default(0)    // Notes created on snapshot day
  errorRate         Float    @default(0)    // Error rate from alert monitor
  avgLatencyMs      Int      @default(0)    // Average latency from request tracer
  createdAt         DateTime @default(now())

  @@unique([snapshotDate])
  @@index([snapshotDate])
}

// ============================================================
// MODUL 39: Onboarding State — Per-user onboarding progress
// ============================================================

model OnboardingState {
  id                  String   @id @default(cuid())
  userId              String   @unique
  welcomeCompleted    Boolean  @default(false)  // Welcome slides completed or skipped
  sampleContentLoaded Boolean  @default(false)  // Sample folder+note seeded
  checklistProgress   String   @default("{}")   // JSON: {upload_file, create_note, use_calc, ...}
  dismissedAt         DateTime? // Nullable: when user permanently dismissed onboarding
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

// ============================================================
// MODUL 40: Multi-Tenancy — Organization & Workspace Data Model
// ============================================================

// 40.1 — Workspace: optional layer above individual ownership
// workspace_id null on nodes = personal workspace (backward-compatible)
model Workspace {
  id         String   @id @default(cuid())
  name       String
  ownerId    String   // original creator, can be transferred (41.5)
  planTier   String   @default("free") // "free" | "pro" | "enterprise" — connected to quota engine (41.1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members         WorkspaceMember[]
  invitations     WorkspaceInvitation[]
  nodes           Node[]
  subscriptions   WorkspaceSubscription[]
  invoices        Invoice[]
  apiKeys         ApiKey[]
  webhookSubscriptions WebhookSubscription[]

  @@index([ownerId])
}

// 40.2 — Workspace members with role enum
// 40.4 — Role-permission matrix: owner (full+billing), admin (manage member+content),
//         member (CRUD per Modul 4/5/9), viewer (read-only = permission_level=view per 13.1)
model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // "owner" | "admin" | "member" | "viewer"
  invitedAt   DateTime @default(now())
  joinedAt    DateTime? // null until invitation accepted

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// 40.6 — Invitation tokens for email-based workspace invitations
model WorkspaceInvitation {
  id          String   @id @default(cuid())
  workspaceId String
  email       String   // invitee email
  role        String   @default("member") // role they'll get upon joining
  token       String   @unique // UUID token for accept/decline
  invitedBy   String   // user who sent the invitation
  expiresAt   DateTime // 7-day expiry per 40.6
  acceptedAt  DateTime? // null until accepted
  declinedAt  DateTime? // null until declined
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
  @@index([email])
}

// ============================================================
// MODUL 42: Billing & Subscription — Payment Provider Integration
// ============================================================

// 42.1 — Subscription lifecycle tracking (Stripe/Midtrans)
// Status enum follows provider documentation: trialing/active/past_due/canceled
model WorkspaceSubscription {
  id                String   @id @default(cuid())
  workspaceId       String
  provider          String   // "stripe" | "midtrans" — billing provider
  providerCustomerId String?  // external customer ID from provider
  providerSubscriptionId String? // external subscription ID from provider
  status            String   @default("active") // "trialing" | "active" | "past_due" | "canceled" | "grace_period"
  currentPeriodStart DateTime? // billing period start
  currentPeriodEnd   DateTime? // billing period end
  cancelAtPeriodEnd  Boolean  @default(false) // scheduled cancellation
  gracePeriodEnd    DateTime? // 42.3 — 3-day retry window before downgrade enforcement
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([providerSubscriptionId])
}

// 42.4 — Invoice history per workspace (owner-only access)
model Invoice {
  id                   String   @id @default(cuid())
  subscriptionId       String
  workspaceId          String
  providerInvoiceId    String?  // external invoice ID from provider
  amount               Int      // amount in smallest currency unit (cents/sen)
  currency             String   @default("usd") // "usd" | "idr"
  status               String   // "paid" | "pending" | "failed" | "refunded"
  paidAt               DateTime?
  dueDate              DateTime?
  pdfUrl               String?  // URL to invoice PDF from provider
  createdAt            DateTime @default(now())

  subscription WorkspaceSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([workspaceId])
}

// ============================================================
// MODUL 43: Public API — API Key & Third-Party Authentication
// ============================================================

// 43.1 — API key generation per-user/workspace
// key_hash stored (NOT plaintext), scopes array, revoked_at for soft-disable
model ApiKey {
  id           String    @id @default(cuid())
  ownerId      String?   // personal API key — FK to users.id
  workspaceId  String?   // workspace API key — FK to workspaces.id
  keyPrefix    String    // first 8 chars of key for identification display
  keyHash      String    @unique // SHA-256 hash of the full API key
  scopes       String    // JSON array: ["read_only"] | ["read_write"] | ["admin"]
  lastUsedAt   DateTime?
  revokedAt    DateTime? // null = active, set = revoked
  createdAt    DateTime  @default(now())

  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([ownerId])
  @@index([workspaceId])
}

// ============================================================
// MODUL 44: Webhook Dispatch — Outbound Event Subscription
// ============================================================

// 44.1 — Webhook subscription: owner registers target_url + event_types + secret
model WebhookSubscription {
  id           String   @id @default(cuid())
  ownerId      String?  // personal webhook
  workspaceId  String?  // workspace webhook
  targetUrl    String   // endpoint URL to receive payloads
  eventTypes   String   // JSON array: ["node.created", "node.deleted", "note.updated", "file.uploaded"]
  secret       String   // HMAC-SHA256 signing secret (44.3)
  isActive     Boolean  @default(true) // can be toggled off
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([ownerId])
  @@index([workspaceId])
  @@index([isActive])
}

// 44.2-44.4 — Webhook delivery log: track each dispatch attempt
// Retry policy: exponential backoff, max 5 attempts, then dead-letter
model WebhookDelivery {
  id               String   @id @default(cuid())
  subscriptionId   String
  eventType        String   // e.g. "node.created"
  payload          String   // JSON payload sent to target_url
  responseStatus   Int?     // HTTP status code from target
  responseBody     String?  // response body (truncated)
  attemptCount     Int      @default(0)
  nextAttemptAt    DateTime? // next retry time (null = no more retries)
  status           String   @default("pending") // "pending" | "success" | "failed" | "dead_letter"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([nextAttemptAt])
}
