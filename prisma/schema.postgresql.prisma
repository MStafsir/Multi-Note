// ============================================================
// PostgreSQL Schema — for Vercel / Supabase / Neon deployment
// This is the same schema as the SQLite version but with
// provider = "postgresql" and proper PostgreSQL types.
//
// HOW TO USE:
// 1. Create a Supabase project (free) at https://supabase.com
// 2. Copy your connection string from Supabase Dashboard > Settings > Database
// 3. Set DATABASE_URL in your .env or Vercel environment variables
// 4. Run: bun run db:push
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth.js Required Tables ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  nodes         Node[]
  profile       Profile?
  calculations  CalculationHistory[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  comments      Comment[]
  noteTemplates NoteTemplate[]
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]
  apiKeys              ApiKey[]
  webhookSubscriptions WebhookSubscription[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- User Profile with Storage Quota ---
model Profile {
  id             String @id @default(cuid())
  userId         String @unique
  role           String @default("user")
  storageUsedBytes BigInt @default(0)
  quotaLimitBytes  BigInt @default(5368709120000) // 5TB — effectively unlimited
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Core Node Table ---
model Node {
  id           String    @id @default(cuid())
  ownerId      String
  parentId     String?
  workspaceId  String?
  type         String
  name         String
  isFavorite   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent     Node?          @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Node[]         @relation("NodeTree")
  workspace  Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metadata   FileMetadata?
  note       NoteContent?
  shares        NodeShare[]
  tags          NodeTag[]
  activity      ActivityLog[]
  versions      FileVersion[]
  revisions     NoteRevision[]
  noteDatabases NoteDatabase[]
  sourceLinks   NoteLink[]  @relation("SourceLinks")
  targetLinks   NoteLink[]  @relation("TargetLinks")
  comments      Comment[]

  @@index([ownerId, parentId])
  @@index([ownerId, type])
  @@index([deletedAt])
  @@index([ownerId, isFavorite])
  @@index([workspaceId])
}

// --- File Metadata ---
model FileMetadata {
  nodeId        String @id @default(cuid())
  storagePath   String
  mimeType      String
  sizeBytes     BigInt
  checksumSha256 String?

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

// --- Note Content ---
model NoteContent {
  nodeId      String @id @default(cuid())
  contentJson String

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

// --- Node Shares ---
model NodeShare {
  id               String    @id @default(cuid())
  nodeId           String
  sharedWithUserId String?
  permissionLevel  String
  shareLinkToken   String?   @unique
  shareLinkExpiry  DateTime?
  linkType         String?
  createdAt        DateTime  @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, sharedWithUserId])
  @@index([shareLinkToken])
}

// --- Tags ---
model Tag {
  id       String @id @default(cuid())
  ownerId  String
  name     String
  colorHex String @default("#6B7280")

  nodes NodeTag[]

  @@unique([ownerId, name])
}

model NodeTag {
  nodeId String
  tagId  String

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([nodeId, tagId])
}

// --- Activity Log ---
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String
  nodeId     String?
  actionType String
  metadata   String?
  createdAt  DateTime @default(now())

  node Node? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([nodeId, createdAt])
  @@index([actorId, createdAt])
}

// --- File Versions ---
model FileVersion {
  id             String   @id @default(cuid())
  nodeId         String
  storagePath    String
  versionNumber  Int
  sizeBytes      BigInt
  checksumSha256 String?
  createdById    String?
  createdAt      DateTime @default(now())

  node Node? @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, versionNumber])
}

// --- Note Revisions ---
model NoteRevision {
  id                  String   @id @default(cuid())
  nodeId              String
  contentJsonSnapshot String
  revisionNumber      Int
  triggerType         String
  createdAt           DateTime @default(now())

  node Node? @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, revisionNumber])
  @@index([nodeId, createdAt])
}

// --- Calculation History ---
model CalculationHistory {
  id         String   @id @default(cuid())
  userId     String
  expression String
  result     String
  mode       String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// --- Notifications ---
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  type        String
  payload     String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

// --- Notification Preferences ---
model NotificationPreference {
  id               String @id @default(cuid())
  userId           String @unique
  shareReceived    String @default("in_app")
  commentAdded     String @default("in_app")
  mention          String @default("in_app")
  quotaWarning     String @default("both")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Database Block ---
model NoteDatabase {
  id             String   @id @default(cuid())
  parentNoteId   String
  title          String   @default("Untitled Database")
  schema         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parentNote Node           @relation(fields: [parentNoteId], references: [id], onDelete: Cascade)
  rows       DatabaseRow[]
  views      DatabaseView[]

  @@index([parentNoteId])
}

model DatabaseRow {
  id         String @id @default(cuid())
  databaseId String
  cellData   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  database NoteDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
}

// --- Database View ---
model DatabaseView {
  id         String   @id @default(cuid())
  databaseId String
  type       String
  name       String   @default("Default View")
  config     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  database NoteDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
}

// --- Note Templates ---
model NoteTemplate {
  id                  String   @id @default(cuid())
  ownerId             String?
  title               String
  contentJsonTemplate String
  category            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([category])
}

// --- Note Links ---
model NoteLink {
  id          String   @id @default(cuid())
  sourceNodeId String
  targetNodeId String
  createdAt   DateTime @default(now())

  sourceNode Node @relation("SourceLinks", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode Node @relation("TargetLinks", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

// --- Comments ---
model Comment {
  id               String    @id @default(cuid())
  nodeId           String
  parentCommentId  String?
  authorId         String
  content          String
  anchorPosition   String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  node          Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  parentComment Comment? @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentThread")
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@index([nodeId, resolvedAt])
  @@index([parentCommentId])
}

// --- Analytics Snapshot ---
model AnalyticsSnapshot {
  id                String   @id @default(cuid())
  snapshotDate      String
  dauCount          Int      @default(0)
  mauCount          Int      @default(0)
  totalStorageBytes BigInt   @default(0)
  totalUsers        Int      @default(0)
  totalNodes        Int      @default(0)
  uploadsPerDay     Int      @default(0)
  notesCreatedPerDay Int     @default(0)
  errorRate         Float    @default(0)
  avgLatencyMs      Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([snapshotDate])
  @@index([snapshotDate])
}

// --- Onboarding State ---
model OnboardingState {
  id                  String   @id @default(cuid())
  userId              String   @unique
  welcomeCompleted    Boolean  @default(false)
  sampleContentLoaded Boolean  @default(false)
  checklistProgress   String   @default("{}")
  dismissedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

// --- Workspace ---
model Workspace {
  id         String   @id @default(cuid())
  name       String
  ownerId    String
  planTier   String   @default("free")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members         WorkspaceMember[]
  invitations     WorkspaceInvitation[]
  nodes           Node[]
  subscriptions   WorkspaceSubscription[]
  invoices        Invoice[]
  apiKeys         ApiKey[]
  webhookSubscriptions WebhookSubscription[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member")
  invitedAt   DateTime @default(now())
  joinedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   @default("member")
  token       String   @unique
  invitedBy   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
  @@index([email])
}

// --- Billing ---
model WorkspaceSubscription {
  id                String   @id @default(cuid())
  workspaceId       String
  provider          String
  providerCustomerId String?
  providerSubscriptionId String?
  status            String   @default("active")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean  @default(false)
  gracePeriodEnd    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([providerSubscriptionId])
}

model Invoice {
  id                   String   @id @default(cuid())
  subscriptionId       String
  workspaceId          String
  providerInvoiceId    String?
  amount               Int
  currency             String   @default("usd")
  status               String
  paidAt               DateTime?
  dueDate              DateTime?
  pdfUrl               String?
  createdAt            DateTime @default(now())

  subscription WorkspaceSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([workspaceId])
}

// --- API Keys ---
model ApiKey {
  id           String    @id @default(cuid())
  ownerId      String?
  workspaceId  String?
  keyPrefix    String
  keyHash      String    @unique
  scopes       String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([ownerId])
  @@index([workspaceId])
}

// --- Webhooks ---
model WebhookSubscription {
  id           String   @id @default(cuid())
  ownerId      String?
  workspaceId  String?
  targetUrl    String
  eventTypes   String
  secret       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([ownerId])
  @@index([workspaceId])
  @@index([isActive])
}

model WebhookDelivery {
  id               String   @id @default(cuid())
  subscriptionId   String
  eventType        String
  payload          String
  responseStatus   Int?
  responseBody     String?
  attemptCount     Int      @default(0)
  nextAttemptAt    DateTime?
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([nextAttemptAt])
}
